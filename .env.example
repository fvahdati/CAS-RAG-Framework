# --- Required: pick ONE LLM provider (real models; no mock unless testing) ---
CAS_RAG_LLM_PROVIDER=openai
# Use real embeddings + RAG retrieval (set 1 only for air-gapped debugging)
CAS_RAG_OFFLINE_MODE=0
# Allow rule-based mock LLM (unit/integration tests only — do not use for thesis runs)
CAS_RAG_ALLOW_MOCK=0

# OpenAI / ChatGPT (when CAS_RAG_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (when CAS_RAG_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama / local Meta Llama (when CAS_RAG_LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hugging Face (embedding model download for sentence-transformers)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Optional: YouTube Data API (future dataset ingestion)
YOUTUBE_API_KEY=

CAS_RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
CAS_RAG_RETRIEVAL_TOP_K=3
CAS_RAG_PROMPT_VERSION=v1
CAS_RAG_LOG_LEVEL=INFO
CAS_RAG_API_HOST=0.0.0.0
CAS_RAG_API_PORT=8000
